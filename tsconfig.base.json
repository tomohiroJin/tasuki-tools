{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // DOM が要るのは web 2 つだけ。core / sync は各パッケージで ES2022 のみ。
    // timer-core が DOM API を使っていないことは実測で確認済み（--lib ES2022 で 0 件）。
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // オプショナルなプロパティへ undefined を明示的に渡すことを禁じる。
    // 「キーが無い」と「キーはあるが undefined」を型で区別する。
    "exactOptionalPropertyTypes": true,
    // 型だけのインポート／エクスポートは import type と書くことを強制する。
    // トランスパイラが型と値を確実に区別でき、副作用の有無が読んで分かる。
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // 出力しない。**tsc で出力するパッケージはもう 1 つも無い**（#173）。
    // かつては timer-core / timer-sync が noEmit: false と declaration / outDir を
    // 上書きしていたが、その出力を読む側が 0 件だったので廃した。
    // 出力が要るのは web（vite）と sync（bun build）で、どちらも tsc を通らない。
    "noEmit": true
  }
}
