{
  "name": "@tasuki/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "e2e": "TASUKI_E2E_TARGET=local playwright test",
    "e2e:prod": "TASUKI_E2E_TARGET=production playwright test --grep \"@smoke|@core\"",
    "lint": "eslint harness fixtures support specs tests parity --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tasuki/landing": "workspace:*",
    "@tasuki/poker-web": "workspace:*",
    "@tasuki/timer-web": "workspace:*",
    "@tasuki/topic-web": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.1.2",
    "playwright-core": "1.63.0",
    "postcss": "^8.5.25",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
