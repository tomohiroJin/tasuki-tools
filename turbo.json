{
  "$schema": "https://turbo.build/schema.json",
  "//": "globalDependencies: パッケージ外にあってタスク結果を左右するファイル。ここに書かないと eslint.config.mjs だけを変えたとき turbo が変更を検知できず、古い lint 結果を cache hit として再生する（＝ルール変更が反映されないまま成功表示になる）。",
  "globalDependencies": ["eslint.config.mjs", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e:prod": {
      "cache": false
    },
    "@tasuki/e2e#test": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "ALLOWED_ORIGINS",
        "MAX_CONNECTIONS",
        "MAX_ROOMS",
        "ROOM_IDLE_TTL_MS",
        "ADMIN_TOKEN",
        "AI_UNLOCK_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "AI_PROBLEM_MODEL",
        "AI_GENERATION_TIMEOUT_MS",
        "AI_DAILY_LIMIT"
      ]
    }
  }
}
