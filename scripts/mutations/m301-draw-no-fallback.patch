# 変異 301: draw-no-fallback
#
# 検出を期待するテスト:
#   - packages/roulette-core/tests/draw-picks.test.ts
#
# #401 E4・spec M8。直前の回転の人を除くと候補が空になる回の落とし先を外す。入る人が少ないと回せなくなる（INVALID_RANDOM）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m301-*.patch
# 復元: git apply -R scripts/mutations/m301-*.patch
diff --git a/packages/roulette-core/src/draw.ts b/packages/roulette-core/src/draw.ts
index d4d0533..7617520 100644
--- a/packages/roulette-core/src/draw.ts
+++ b/packages/roulette-core/src/draw.ts
@@ -49,7 +49,7 @@ export function drawPicks(
       open = pool.filter((e) => !picked.has(e.id));
     }
     const fresh = closed ? open.filter((e) => !lastIds.has(e.id)) : open;
-    const eligible = fresh.length > 0 ? fresh : open;
+    const eligible = fresh;
     const chosen = eligible[randomInt(eligible.length)];
     // randomInt が契約（[0, n)）を破った。サーバーの乱数源は契約を守るので、ここへは来ない
     if (chosen === undefined) return err({ code: "INVALID_RANDOM" });
