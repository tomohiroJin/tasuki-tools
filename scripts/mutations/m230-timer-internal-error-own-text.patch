+      internalErrorFrame: { type: "error", code: "INTERNAL_ERROR", message: "内部エラーが発生しました" },
     }),
     hub: rawTextChannel<HubServerMsg>("hub", options.hub, frames),
     // エラーフレームの型は広い `TopicServerMsg` ではなく狭い `TopicOwnFrame`（#91 R18）。
