diff --git a/packages/checkin-core/src/projection.ts b/packages/checkin-core/src/projection.ts
index 7fef8430..71ff5e72 100644
--- a/packages/checkin-core/src/projection.ts
+++ b/packages/checkin-core/src/projection.ts
@@ -94,7 +94,6 @@ export function toView(s: CheckinState, viewerId: string, seats: readonly SeatIn
   const piles: PileView[] = METHODS[r.method].cards.map((card) => {
     // count と names は同じ基準（seats 入力に居る人の札だけ）で数える
     const holders = seatViews.filter((x) => r.cards.get(x.id) === card);
-    if (r.visibility === "anonymous") return { card, count: holders.length };
     return { card, count: holders.length, names: holders.map((x) => x.name) };
