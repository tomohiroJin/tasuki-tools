# 変異 479: invite-url-with-aria-label
#
# 検出を期待するテスト:
#   - packages/invite-ui/tests/room-header.test.tsx
#     「Given URL の欄 / When 描く / Then aria-label を持たない」
#
# #447 段 1・設計 R2。URL の欄に aria-label を付ける。role の無い span の aria-label は読み上げで扱いが揺れ、見えている字と名前が二重になる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m479-*.patch
# 復元: git apply -R scripts/mutations/m479-*.patch
diff --git a/packages/invite-ui/src/RoomHeader.tsx b/packages/invite-ui/src/RoomHeader.tsx
--- a/packages/invite-ui/src/RoomHeader.tsx
+++ b/packages/invite-ui/src/RoomHeader.tsx
@@ -135,7 +135,7 @@
           <div className="ui-invite">
             {/* 省略しない。長ければどこでも折り返して全部見せる（クリップボードが使えない端末では目で読むしかない）。`title`・`aria-label` は付けない
                 （触る端末ではツールチップが出ず、読み上げで URL が二重になる）。 */}
-            <span className="ui-invite-url">{inviteUrl}</span>
+            <span className="ui-invite-url" aria-label={inviteUrl}>{inviteUrl}</span>
             {/* QR とコピーを 1 つにまとめる（折り返すとき、2 つのボタンが別の行に分かれない）。 */}
             <div className="ui-room-header-invite-actions">
             {/* ボタンと浮かぶ QR を包む。外側を押したかの判定と、QR を浮かべる位置の基準にする。 */}
