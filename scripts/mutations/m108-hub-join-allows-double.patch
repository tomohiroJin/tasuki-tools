# 変異 108: hub-join-allows-double
#
# 検出を期待するテスト:
#   - apps/tasuki-sync/test/live-ws.hub.test.ts
#     describe「ハブの二重参加を拒む」の
#     「Given ルーム A に入ったハブ接続 / When 別のルーム B へ room.join / Then INVALID_COMMAND が返り、…」
#     「Given ルーム A に入ったハブ接続 / When 同じルーム A へもう一度 room.join / Then INVALID_COMMAND が返り、…」
#
#   - apps/tasuki-sync/test/live-ws.join-entries.test.ts（hub・topic・roulette の「2 度目の参加」）
#   - apps/tasuki-sync/test/join-tool-room.test.ts「もう一度参加する」
#
# #91 PR 3（Task 5 のレビュー）。`room.join` から 2 度目の参加の拒否を外す。
# **#366 で、拒否は hub・topic・roulette が共有する `join-tool-room.ts` へ移った**ので、この変異は
# 3 つの入口をまとめて壊す（ID と意味は変えない）。1 本のハブ接続が 2 つのルームの名簿に載り（同じルームなら人数が増え）、
# お題の配信先の数え上げと在席がずれる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m108-*.patch
# 復元: git apply -R scripts/mutations/m108-*.patch
diff --git a/apps/tasuki-sync/src/application/join-tool-room.ts b/apps/tasuki-sync/src/application/join-tool-room.ts
index 6e1cc40..6910cb4 100644
--- a/apps/tasuki-sync/src/application/join-tool-room.ts
+++ b/apps/tasuki-sync/src/application/join-tool-room.ts
@@ -40,10 +40,6 @@ export function joinToolRoom(deps: JoinRoomDeps & SaveRosterDeps, input: JoinToo
   // 通すと 1 本のソケットが 2 つのルームに載り（または 2 人の参加者が同じ接続を持ち）、切断の片付けが
   // 片方しか外さず、幽霊の参加者が残ってルームが回収されなくなる（#91 PR 3 Task 5 の特徴づけで実測）。
   // 正規の画面からは届かない（改造したクライアントだけ）ので、形の不正なコマンドと同じ文言で突き返す。
-  if (findRoomByConnId(deps.store, connId) !== undefined) {
-    reply({ type: "error", code: "INVALID_COMMAND", message: CONNECTION_ERROR_TEXT.INVALID_COMMAND });
-    return;
-  }
 
   // 表示名は名簿の規約で正規化する。見えない文字だけの名前や上限を超える名前は拒む。
   const applied = applyDisplayNameRule(cmd.displayName);
