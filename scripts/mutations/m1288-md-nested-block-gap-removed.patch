diff --git a/packages/ui/src/components/markdown.css b/packages/ui/src/components/markdown.css
--- a/packages/ui/src/components/markdown.css
+++ b/packages/ui/src/components/markdown.css
@@ -152,8 +152,3 @@
 /* 入れ子のブロック（引用の中・リストの項目の中）も、根と同じ間 `--space-2` にする。同じく**子のリセットより後ろ**に書く後勝ち（詳細度は根の規則と同じ (0,1,0)。
    `*` は詳細度に数えないので、`.ui-md-ul > * > * + *` は「リストの項目の直下で、先頭でない子」を指して (0,1,0) のまま）。
    いまの描画（`@tasuki/web-kit`）は引用・項目の中に行しか入れないが、入れ子のブロックを描くようになったとき、間が 0 のままにならない。 */
-.ui-md-quote > * + *,
-.ui-md-ul > * > * + *,
-.ui-md-ol > * > * + * {
-  margin-top: var(--space-2);
-}
