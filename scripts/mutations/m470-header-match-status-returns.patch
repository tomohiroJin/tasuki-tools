# 変異 470: header-match-status-returns
#
# 検出を期待するテスト:
#   - apps/landing/tests/caddy-fragment-order.test.ts
#
# #434。immutable の header に `match status 2xx` を戻す。本番の Caddy 2.6.2 は match を条件と読まず、validate も E2E も通ったまま 404 に 1 年の immutable が付く（2026-10-24 の配布で実際に起きた）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m470-*.patch
diff --git a/deploy/caddy/tasuki.conf b/deploy/caddy/tasuki.conf
--- a/deploy/caddy/tasuki.conf
+++ b/deploy/caddy/tasuki.conf
@@ -90,7 +90,10 @@
 		path */assets/*
 		path_regexp \.[^/]+$
 	}
-	header @hashed Cache-Control "public, max-age=31536000, immutable"
+	header @hashed {
+		Cache-Control "public, max-age=31536000, immutable"
+		match status 2xx
+	}
 	header @unhashed Cache-Control "no-cache"
 	header /site.webmanifest Content-Type "application/manifest+json"
 	handle_errors {
