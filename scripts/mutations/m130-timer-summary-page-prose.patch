# 変異 130: timer-summary-page-prose
#
# 検出を期待するテスト:
#   - apps/timer-web/test/ui/App.page-tier.test.tsx
#     「Given ルームのセッション / When 完了の snapshot が届く / Then 器の段は変わらない（帯ごと幅が跳ねない）」
#
# #352・設計 D1。`pageOf` がまとめ（celebration）だけを部屋の器から外し、既定の 40rem に落とす（段階を問わず wide にする条件へ、まとめを除く一文を足す）。
# 完了した瞬間に、ステータスの帯ごと画面の幅が 1536px から 640px へ縮む（#352 の利用者のフィードバック）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m130-*.patch
# 復元: git apply -R scripts/mutations/m130-*.patch
diff --git a/apps/timer-web/src/App.tsx b/apps/timer-web/src/App.tsx
--- a/apps/timer-web/src/App.tsx
+++ b/apps/timer-web/src/App.tsx
@@ -35,7 +35,7 @@ function pageOf(historyOpen: boolean, sessionLost: boolean, mode: string | null
   if (historyOpen) return "default";
   if (sessionLost) return "prose";
   // ルームの画面が決まっていて（`mode` が非 null）、ルームがある間は、段階（ロビー・セッション・まとめ）を問わず部屋の器。
   // ここに画面名を列挙しない。段階を足しても器は変わらない（#352）
-  if (mode != null && hasRoom) return "wide";
+  if (mode != null && mode !== "celebration" && hasRoom) return "wide";
   return "prose";
 }
 
