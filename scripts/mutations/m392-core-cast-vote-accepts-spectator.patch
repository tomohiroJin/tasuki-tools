# 変異 392: core-cast-vote-accepts-spectator
#
# 検出を期待するテスト:
#   - packages/poker-core/tests/round.test.ts
#
# #419。castVote が見学者の票を受ける（spectating エラーを返さない）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m392-*.patch
# 復元: git apply -R scripts/mutations/m392-*.patch
diff --git a/packages/poker-core/src/round.ts b/packages/poker-core/src/round.ts
index 7b0d8e1d..8d8e0f9e 100644
--- a/packages/poker-core/src/round.ts
+++ b/packages/poker-core/src/round.ts
@@ -60,9 +60,6 @@ export function castVote(round: Round, voterId: string, card: Card): Result<Roun
   if (round.status !== 'voting') {
     return err({ code: 'not-voting', op: 'vote' });
   }
-  if (round.spectators.has(voterId)) {
-    return err({ code: 'spectating', op: 'vote' });
-  }
   const votes = new Map(round.votes);
   votes.set(voterId, card);
   return ok({ ...round, votes });
