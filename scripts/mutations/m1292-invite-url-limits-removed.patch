# 変異 1292: invite-url-limits-removed
#
# 検出を期待するテスト:
#   - packages/ui/tests/dock-and-narrow-header.test.mjs
#   - e2e/specs/header-and-dock.spec.ts（実際の見え方。変異検査の外。長い URL が欄の外へ出て赤）
#
# #554 のレビュー。URL の上限と下限を外すと、grid の項目（justify-self: start）では効かず、長い URL が 30〜44rem の欄で画面の外へ出る。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1292-*.patch
# 復元: git apply -R scripts/mutations/m1292-*.patch
--- a/packages/ui/src/components/invite.css
+++ b/packages/ui/src/components/invite.css
@@ -27,8 +27,6 @@
   font-family: var(--font-mono);
   /* 欄の幅で止める。`.ui-room-header-invite` の中では折り返す flex の項目になり、中身（max-content）の長さを基準にする。長い URL（日本語のルーム名がそのまま入りうる）が
      欄より長いときは、上限（max-inline-size）と下限（min-inline-size: 0）で欄の幅まで縮み、区切りの無い長い URL でもどこでも折り返して全部見せる（#554） */
-  min-inline-size: 0;
-  max-inline-size: 100%;
   word-break: break-all;
   /* 1 回押すと URL 全体が選ばれる。クリップボードが使えない端末（非セキュアオリジン）で、手で選んでコピーする唯一の道（#76 F-1）。
      timer の旧 InvitePanel が持っていた性質を、5 つのアプリの共通の部品へ移した（#447 段 2） */
