# 変異 185: 止まった後の円盤を、いまの入る人の並びで描く（角度は回したときの席数のまま）
#
# 検出を期待するテスト:
#   - apps/roulette-web/tests/wheel.test.tsx
#     describe「止まった後に入る人が変わる」の 2 件（ゲストが増える・名簿の順だけが変わる）
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m185-*.patch
# 復元: git apply -R scripts/mutations/m185-*.patch
#
# #94 spec §6.3（PR #383 のレビュー）。止まった角度は `spin.wheel` の席数と当たりの添字で計算する。
# 止まった後に描く席をいまの入る人へ替えると、席数や順が変わったとき針が別の人を指し、札は本当の当たりを
# 見せる（針と札が食い違う）。次に回すまで、回したときの並びを描き続ける。
diff --git a/apps/roulette-web/src/wheel-view.ts b/apps/roulette-web/src/wheel-view.ts
index d5e1f51..11643eb 100644
--- a/apps/roulette-web/src/wheel-view.ts
+++ b/apps/roulette-web/src/wheel-view.ts
@@ -20,5 +20,6 @@ export interface WheelSeats {
 export function wheelSeatsOf(input: { pool: readonly Entry[]; spin: RouletteView['spin']; revealed: number }): WheelSeats {
   const { pool, spin, revealed } = input;
   if (spin === null) return { entries: pool, winners: [] };
-  return { entries: spin.wheel, winners: picksOf(spin).slice(0, revealed).map((p) => p.index) };
+  if (revealed < picksOf(spin).length) return { entries: spin.wheel, winners: picksOf(spin).slice(0, revealed).map((p) => p.index) };
+  return { entries: pool, winners: picksOf(spin).map((p) => pool.findIndex((e) => e.id === spin.wheel[p.index]?.id)) };
 }
