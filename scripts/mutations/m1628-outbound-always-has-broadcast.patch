# 変異 1628: outbound-always-has-broadcast
#
# 検出を期待するテスト:
#   - apps/tasuki-sync/test/ws/raw-tools.test.ts
#
# #591。チェックインにも実行時に broadcast を作る（旗の表 RAW_BROADCAST を読まない）。型は表のままなので型検査は緑で、実行時にだけ全員へ送る口ができる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1628-*.patch
# 復元: git apply -R scripts/mutations/m1628-*.patch
diff --git a/apps/tasuki-sync/src/adapters/ws-adapter.ts b/apps/tasuki-sync/src/adapters/ws-adapter.ts
index 4a1c83c9..f488374b 100644
--- a/apps/tasuki-sync/src/adapters/ws-adapter.ts
+++ b/apps/tasuki-sync/src/adapters/ws-adapter.ts
@@ -403,7 +403,7 @@ export class WsAdapter {
         sendToEach(this.connections, connIds, JSON.stringify(data));
       };
       // 全員へ同じものを送る口を持たないツール（チェックイン。#406）には**実行時にも作らない**。旗は `RAW_BROADCAST` が 1 か所で持つ。
-      return [id, RAW_BROADCAST[id] ? { send, broadcast } : { send }];
+      return [id, true ? { send, broadcast } : { send }];
     }),
   ) as unknown as RawOutbound;
 
