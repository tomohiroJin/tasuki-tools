diff --git a/apps/timer-sync/src/application/handlers.ts b/apps/timer-sync/src/application/handlers.ts
index 124c466..bde82a4 100644
--- a/apps/timer-sync/src/application/handlers.ts
+++ b/apps/timer-sync/src/application/handlers.ts
@@ -1437,7 +1437,7 @@ function computeIneligibleIndices(room: Room): Set<number> {
       // 一時離脱(driverEligible=false)は対象外。実在の切断中(offline)の人も対象外（R2-1）。
       // ただし代理(placeholder)は Web 非接続が常態で対面在席する実在の人を表すため、
       // offline でも eligible として扱う（さもないとタイマー自動交代で永久に飛ばされ交代しない）。
-      .filter((p) => p.driverEligible === false || (p.presence === "offline" && p.isPlaceholder !== true))
+      .filter((p) => p.driverEligible === false || p.presence === "offline")
       .map((p) => p.participantId),
   );
   const set = new Set<number>();
