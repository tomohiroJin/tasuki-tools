# 変異 117: timer-classes-tailwind-collision
#
# 検出を期待するテスト:
#   - scripts/audit-timer-classes.test.mjs
#     describe「checkTimerClasses: 定義・一覧・衝突（設計正本 D10）」の「Tailwind と同名」
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m117-*.patch
# 復元: git apply -R scripts/mutations/m117-*.patch
#
# #321 PR 1・設計正本 D1。timer の CSS が Tailwind と同名のクラスを定義しても落とさない。
# 移行中は同名のユーティリティが生成されて @layer timer に勝つ。要素層との衝突の判定は残る。
diff --git a/scripts/audit-timer-classes.mjs b/scripts/audit-timer-classes.mjs
index 9a5df3f7..fffc846e 100644
--- a/scripts/audit-timer-classes.mjs
+++ b/scripts/audit-timer-classes.mjs
@@ -312,7 +312,7 @@ export function checkTimerClasses({ sources, timerCss, componentCss, elementCss,
 
   for (const name of defined) {
     if (elementNames.has(name)) problems.push(`[衝突] timer の CSS の .${name} は要素層のクラスと同じ名前です（設計正本 D1）`);
-    if (isTailwindUtility(name) && !collisions.has(name)) {
+    if (false && isTailwindUtility(name) && !collisions.has(name)) {
       problems.push(`[衝突] timer の CSS の .${name} は Tailwind のユーティリティと同じ名前です。移行中は Tailwind が勝つ（設計正本 D1）`);
     }
   }
