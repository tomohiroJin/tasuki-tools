# 変異 3106: track-edge-nearest-day-off
#
# 検出を期待するテスト:
#   - apps/track-web/tests/time-input.test.ts
#   - apps/track-web/tests/track-room.test.tsx
#
# #476 端を合わせる時刻が、前日・翌日の読みを持たず、同じ日の時刻でしか読まれない。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m3106-*.patch
# 復元: git apply -R scripts/mutations/m3106-*.patch
diff --git a/apps/track-web/src/time-input.ts b/apps/track-web/src/time-input.ts
index 1d057ce0..fa744796 100644
--- a/apps/track-web/src/time-input.ts
+++ b/apps/track-web/src/time-input.ts
@@ -49,7 +49,7 @@ function clockPositionsByDistance(clockMs: number, refPosMs: number, epochWallMs
   const shift = tzOffsetMin * MS_PER_MIN;
   const refLocal = epochWallMs + refPosMs + shift;
   const dayStart = Math.floor(refLocal / MS_PER_DAY) * MS_PER_DAY;
-  return [0, -1, 1]
+  return [0]
     .map((days) => dayStart + days * MS_PER_DAY + clockMs)
     .sort((a, b) => Math.abs(a - refLocal) - Math.abs(b - refLocal))
     .map((local) => Math.round(local - shift - epochWallMs));
