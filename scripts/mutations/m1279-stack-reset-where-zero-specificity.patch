diff --git a/packages/ui/src/components/stack.css b/packages/ui/src/components/stack.css
--- a/packages/ui/src/components/stack.css
+++ b/packages/ui/src/components/stack.css
@@ -14,7 +14,7 @@
 /* 直下の子の縦の外側の余白を 0 にする。要素層の `h2` の `margin-top` などが `gap` に足されて間が開きすぎるのを防ぐ。
    詳細度は (0,1,0)。要素層の margin（0,0,1）には勝つが、**同じ詳細度で後に読む部品**（`.ui-reader-preview`・`.ui-reader-more`・64rem 以上の `.ui-reader-body`）の margin には負ける。
    だから、縦の margin を持つ部品を `.ui-stack` の直下に置かない（置くと gap に足される）。`:where()` で詳細度を 0 にはしない（要素層に負けて役目を失う）。 */
-.ui-stack > * {
+:where(.ui-stack) > * {
   margin-block: 0;
 }
 
