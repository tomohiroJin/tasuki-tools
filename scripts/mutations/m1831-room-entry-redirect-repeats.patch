diff --git a/apps/poker-web/src/room-entry-plan.ts b/apps/poker-web/src/room-entry-plan.ts
--- a/apps/poker-web/src/room-entry-plan.ts
+++ b/apps/poker-web/src/room-entry-plan.ts
@@ -37,7 +37,7 @@ export function decideEntryRedirect(
   errorCode: string | null | undefined,
   hasIdentity: () => boolean,
 ): { readonly applied: boolean; readonly redirect: boolean } {
