# 変異 167: roulette-skips-on-connect
#
# 検出を期待するテスト:
#   - apps/tasuki-sync/test/live-ws.roulette.test.ts
#
# #94 §5.2・m167。ルーレットの接続の受理で onConnect を通さない（poker の早期 return に足す）。レート制限の鍵が接続 ID に落ち、room.join の総当たりが接続を張り直すだけで枠を回避できる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m167-*.patch
# 復元: git apply -R scripts/mutations/m167-*.patch
diff --git a/apps/tasuki-sync/src/adapters/ws-adapter.ts b/apps/tasuki-sync/src/adapters/ws-adapter.ts
