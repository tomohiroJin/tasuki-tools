 export function awayPromptOf(view: TrackView, nowMs: number, receivedAt: number, away: AwayReturn | null): AwayPrompt | null {
   if (away === null || receivedAt < away.returnedAt) return null;
   const hiddenMs = nowMs - away.fromMs;
