# 変異 163: 止まる角度の端数が回し始めの角度を引かない（画面ごとに止まる席がずれる）
#
# 検出を期待するテスト:
#   - apps/roulette-web/tests/wheel-motion.test.ts
#     「finalAngle: どの画面も同じ席で止まる」の
#     「指し針の下にあるのは当たりの席の中で、境目から 0.2 席ぶん以上離れている」
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m163-*.patch
# 復元: git apply -R scripts/mutations/m163-*.patch
#
# #94 spec §6.4。止まる角度は「開始角 + TURNS 周 + 端数」で、端数が開始角を引くから 360° の剰余が
# 開始角に依らず、どの画面も同じ席で止まる。引かないと、開始角が 0° 以外の画面（前の回転の止まった
# 位置から回す画面）だけが別の席で止まる。開始角 0° だけで試すテストは緑のまま通る。
diff --git a/apps/roulette-web/src/wheel-motion.ts b/apps/roulette-web/src/wheel-motion.ts
index 953c7c73..a41e4f9e 100644
--- a/apps/roulette-web/src/wheel-motion.ts
+++ b/apps/roulette-web/src/wheel-motion.ts
@@ -31,7 +31,7 @@ const mod = (x: number, m: number): number => ((x % m) + m) % m;
  * その画面が見せている角度で、0° へ戻さない（戻すと前の止まった位置から跳ぶ）。
  */
 export function finalAngle(n: number, winnerIndex: number, settle: number, pointerDeg: number, startDeg: number): number {
-  return startDeg + 360 * TURNS + mod(pointerDeg - (winnerIndex + settle) * (360 / n) - startDeg, 360);
+  return startDeg + 360 * TURNS + mod(pointerDeg - (winnerIndex + settle) * (360 / n), 360);
 }
 
 /** 3 次の減速（4 次だと最後の 1 秒がほぼ止まって見えた）。 */
