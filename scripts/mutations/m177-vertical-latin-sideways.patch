# 変異 177: 縦書きの席の欧文を立てない（text-orientation を既定の mixed に戻す）
#
# 検出を期待するテスト:
#   - apps/roulette-web/tests/wheel-glyphs.test.tsx
#     describe「席の名前の字は倒れない（描かれた transform と CSS から組み立てる）」の各席数
#   - （mutation-check の外）e2e/specs/roulette.spec.ts の expectWheelGlyphsUpright
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m177-*.patch
# 復元: git apply -R scripts/mutations/m177-*.patch
#
# #94 spec §6.3。縦書きの欧文はブラウザが 90° 回して横倒しに組む。2026-10-13 の実画面の「Mika」で、
# 関数の戻り値だけを測る単体（全組で ±45°）は緑のままだった。
diff --git a/apps/roulette-web/src/index.css b/apps/roulette-web/src/index.css
index e0f55f95..84816ff1 100644
--- a/apps/roulette-web/src/index.css
+++ b/apps/roulette-web/src/index.css
@@ -172,7 +172,6 @@
   writing-mode: vertical-rl;
   /* 欧文も立てて積む。既定（mixed）では欧文を 90° 回して横倒しに組み、字が ±45° を超えて倒れる
      （2026-10-13 の実画面の「Mika」。spec §6.3）。立てた欧文は 1 字 1em を取るので fitLabel も全角で数える */
-  text-orientation: upright;
 }
 .wheel-label--winner {
   fill: var(--on-gold);
