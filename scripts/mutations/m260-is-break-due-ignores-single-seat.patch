# 変異 260: isBreakDue が適格 0/1 席の周回でも休憩を入れる
#
# 検出を期待するテスト:
#   - packages/timer-core/test/break-policy.test.ts
#
# 適用: リポジトリルートから git apply scripts/mutations/m260-*.patch
# 復元: git apply -R scripts/mutations/m260-*.patch
#
# #402。席が 1 つ以下だと閾値が 0 席ぶんになり、交代のたびに休憩に入る。
diff --git a/packages/timer-core/src/break-policy.ts b/packages/timer-core/src/break-policy.ts
index d0799721..ad225081 100644
--- a/packages/timer-core/src/break-policy.ts
+++ b/packages/timer-core/src/break-policy.ts
@@ -64,7 +64,6 @@ export function isBreakDue(agg: Aggregate, policy: BreakPolicy, eligibleSeats: n
     case "elapsed":
       return agg.clock.accumulatedElapsedMs - base.elapsedMs >= policy.every * MS_PER_MINUTE;
     case "rounds":
-      if (eligibleSeats <= 1) return false;
       return agg.session.totalSwitches - base.switches >= eligibleSeats * policy.every;
   }
 }
