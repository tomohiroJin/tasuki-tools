# 変異 1297: button-hidden-rule-removed
#
# 検出を期待するテスト:
#   - packages/ui/tests/dock-and-narrow-header.test.mjs
#   - e2e/specs/header-and-dock.spec.ts（実際の見え方。変異検査の外。帯でない .ui-actions の hidden のボタンが描かれて赤）
#
# #554 のレビュー。.ui-button の display: inline-flex が UA の [hidden] に勝ち、hidden のボタンが描かれる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1297-*.patch
# 復元: git apply -R scripts/mutations/m1297-*.patch
diff --git a/packages/ui/src/components/button.css b/packages/ui/src/components/button.css
--- a/packages/ui/src/components/button.css
+++ b/packages/ui/src/components/button.css
@@ -37,10 +37,6 @@
 
 /* `display: inline-flex` が UA の `[hidden] { display: none }` に勝つので、`hidden` のボタンが描かれてしまう（部品全体の欠陥。#554）。
    帯の中だけでなく、どの `.ui-button` でも `hidden` なら描かない */
-.ui-button[hidden] {
-  display: none;
-}
-
 .ui-button:where(:hover:not(:disabled)) {
   filter: brightness(1.06);
 }
