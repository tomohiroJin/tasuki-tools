# 変異 153: spin-allows-while-spinning
#
# 検出を期待するテスト:
#   - packages/roulette-core/tests/roulette.test.ts
#
# #94 E5・spec R9。回転中の拒否を外す。2 回目の回転が 1 回目を上書きし、画面ごとにどちらを見ているかがずれる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m153-*.patch
# 復元: git apply -R scripts/mutations/m153-*.patch
diff --git a/packages/roulette-core/src/roulette.ts b/packages/roulette-core/src/roulette.ts
index 7ad8745..88cdec5 100644
--- a/packages/roulette-core/src/roulette.ts
+++ b/packages/roulette-core/src/roulette.ts
@@ -51,7 +51,7 @@ function isSpinning(state: RouletteState, now: number): boolean {
  * 回す。回転中は拒む。決め方で分ける（#401 順番に回す T1）。
  */
 export function startSpin(state: RouletteState, input: SpinInput): Result<RouletteState, RouletteError<SpinErrorCode>> {
-  if (isSpinning(state, input.now)) return err({ code: "ROULETTE_SPINNING" });
+
   if (state.mode === "press") return startPressSpin(state, input);
   return state.mode === "order" ? startOrderSpin(state, input) : startOnceSpin(state, input);
 }
