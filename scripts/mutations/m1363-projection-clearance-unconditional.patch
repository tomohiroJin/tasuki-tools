# 変異 1363: projection-clearance-unconditional
#
# 検出を期待するテスト:
#   - apps/agenda-web/tests/use-projection-clearance.test.tsx（768×1024 の寸法を差し替えた試験）
#   - e2e/specs/header-and-dock.spec.ts（実際の見え方。変異検査の外。768×1024 で帯が出ると縦のスクロールが現れて赤）
#
# #554 のレビュー。帯が出ているとき、帯の高さを無条件に余白へ足す（帯が中身に重ならなくても。縦に長い 40〜64rem の画面だけ）。帯の出し入れで盤が動く。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1363-*.patch
# 復元: git apply -R scripts/mutations/m1363-*.patch
--- a/apps/agenda-web/src/hooks/use-projection-clearance.ts
+++ b/apps/agenda-web/src/hooks/use-projection-clearance.ts
@@ -61,7 +61,7 @@
         const pinned = body.getBoundingClientRect().height;
         let clearance = 0;
         for (let i = 0; i < 4; i += 1) {
-          const need = stripHeight - spaceBelowContent();
+          const need = root.clientWidth < 1000 && root.clientHeight > 900 ? stripHeight : stripHeight - spaceBelowContent();
           if (need <= 0.5) break;
           clearance += Math.ceil(need);
           root.style.setProperty('--projection-body-pin', `${pinned}px`);
