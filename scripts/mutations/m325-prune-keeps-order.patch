# 変異 325: prune-keeps-order
#
# 検出を期待するテスト:
#   - packages/roulette-core/tests/roulette-turn-order.test.ts
#
# #401 順番に回す T5・T6。名簿から消えた人を番の記録から落とさない。抜けた人の記録が残り続ける。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m325-*.patch
# 復元: git apply -R scripts/mutations/m325-*.patch
diff --git a/packages/roulette-core/src/roulette.ts b/packages/roulette-core/src/roulette.ts
index 040e099..591f08c 100644
--- a/packages/roulette-core/src/roulette.ts
+++ b/packages/roulette-core/src/roulette.ts
@@ -218,7 +218,7 @@ export function prune(state: RouletteState, knownIds: Iterable<EntryId>): Roulet
   const known = new Set(knownIds);
   const excluded = state.excluded.filter((id) => known.has(id));
   const drawn = state.drawn.filter((id) => known.has(id));
-  const order = filterOrder(state.order, (id) => known.has(id));
+  const order = state.order;
   // 何も落ちなければ同じ参照を返す（同期サーバーが「変わっていない」を参照で判定する）
   if (excluded.length === state.excluded.length && drawn.length === state.drawn.length && order === state.order) return state;
   return { ...state, excluded, drawn, order };
