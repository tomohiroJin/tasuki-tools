# 変異 180: 同じ回転のフレームで、基準の時刻は古いまま新しい経過を採る
#
# 検出を期待するテスト:
#   - apps/roulette-web/tests/use-roulette-sync.test.tsx
#
# describe「受け取った状態の保持」の「Given 回転中 / When 誰かの操作で同じ seq・進んだ elapsedMs の状態を受ける / Then 止まる時刻も局面も変わらず…」
# (PR #357 の /code-review)
# #94 E17・spec §6.4。同じ回転のフレームで、基準の時刻は古いまま新しい elapsedMs を採る。
# 経過を二重に数え、回転中の外す・戻すや再接続のたびに止まる時刻が前へずれる（画面ごとに当たりの出る時刻が違う）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m180-*.patch
# 復元: git apply -R scripts/mutations/m180-*.patch
diff --git a/apps/roulette-web/src/hooks/use-roulette-sync.ts b/apps/roulette-web/src/hooks/use-roulette-sync.ts
index ebbc63f9..365ac509 100644
--- a/apps/roulette-web/src/hooks/use-roulette-sync.ts
+++ b/apps/roulette-web/src/hooks/use-roulette-sync.ts
@@ -204,7 +204,7 @@ export function useRouletteSync(roomCode: string): RouletteSync {
             // （回転中の外す・戻すや再接続で同じ seq が届くたびに、止まる時刻が前へずれる）。
             // 回転以外（外した人・ゲスト・一周の記録）は新しいフレームのものを採る。
             prev !== null && prev.view.spin !== null && prev.view.spin.seq === view.spin?.seq
-              ? { view: { ...view, spin: prev.view.spin }, receivedAt: prev.receivedAt }
+              ? { view, receivedAt: prev.receivedAt }
               : { view, receivedAt: now },
           );
           setError(null);
