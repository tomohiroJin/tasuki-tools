# 変異 154: pool-includes-offline
#
# 検出を期待するテスト:
#   - packages/roulette-core/tests/pool.test.ts
#
# #94 E4・spec R7。`poolOf` が離席中の参加者も入れる。離席中の 1 人を除くと 2 人未満になる局面で、回せてしまう誤りとして出る。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m154-*.patch
# 復元: git apply -R scripts/mutations/m154-*.patch
diff --git a/packages/roulette-core/src/pool.ts b/packages/roulette-core/src/pool.ts
index ff7ee176..ebaaf364 100644
--- a/packages/roulette-core/src/pool.ts
+++ b/packages/roulette-core/src/pool.ts
@@ -14,7 +14,7 @@ import type { Entry, Member, RouletteState } from "./types.js";
 export function poolOf(members: readonly Member[], state: RouletteState): Entry[] {
   const excluded = new Set(state.excluded);
   const fromMembers = members
-    .filter((m) => m.present && !excluded.has(m.id))
+    .filter((m) => !excluded.has(m.id))
     .map((m): Entry => ({ id: m.id, name: m.name }));
   const fromGuests = state.guests.filter((g) => !excluded.has(g.id)).map((g): Entry => ({ id: g.id, name: g.name }));
   return [...fromMembers, ...fromGuests];
