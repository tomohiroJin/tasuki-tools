# 変異 1227: narrow-back-order-first
#
# 検出を期待するテスト:
#   - packages/ui/tests/dock-and-narrow-header.test.mjs
#   - e2e/specs/header-and-dock.spec.ts（実際の見え方。変異検査の外）
#
# #554 のレビュー。40rem 未満で戻るを order で道具のボタンの前に出し、Tab と読み上げの順が見た目と食い違う（右から左へ戻る）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1227-*.patch
# 復元: git apply -R scripts/mutations/m1227-*.patch
diff --git a/packages/ui/src/components/room-header.css b/packages/ui/src/components/room-header.css
--- a/packages/ui/src/components/room-header.css
+++ b/packages/ui/src/components/room-header.css
@@ -118,6 +118,7 @@
    負の margin で打ち消すと、戻るが道具のボタンの右隣に並ぶ幅（662〜700px 前後）で、ボタンとの間が 3px まで縮んだ（flex の gap から 9px が引かれる）。
    余白を持たなければ隣との間は gap のままで、押せる高さ 44px も幅（字の幅）も保たれる。右端に置かれるときは右寄せなので見た目が変わらない */
 .ui-room-header .ui-page-header-back {
+  order: -1;
   padding-inline-start: 0;
   border-inline-start-width: 0;
 }
