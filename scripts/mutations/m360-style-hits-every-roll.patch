@@ -15,7 +15,6 @@ const isIndex = (i: number, n: number): boolean => Number.isInteger(i) && i >= 0
 export function drawStopStyle(randomInt: (n: number) => number): Result<StopStyle | null, RouletteError<"INVALID_RANDOM">> {
