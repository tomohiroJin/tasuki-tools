# 変異 393: core-discard-keeps-spectator
#
# 検出を期待するテスト:
#   - packages/poker-core/tests/round.test.ts
#
# #419。discardVote が見学の集合から外さない（退出した人が見学に残り、再入室で見学のままになる）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m393-*.patch
# 復元: git apply -R scripts/mutations/m393-*.patch
diff --git a/packages/poker-core/src/round.ts b/packages/poker-core/src/round.ts
index 8d99391..a4a53ba 100644
--- a/packages/poker-core/src/round.ts
+++ b/packages/poker-core/src/round.ts
@@ -277,8 +277,7 @@ export function discardVote(round: Round, voterId: string): Round {
   if (!round.votes.has(voterId) && !round.spectators.has(voterId) && game === round.game) return round;
   const votes = new Map(round.votes);
   votes.delete(voterId);
-  const spectators = new Set(round.spectators);
-  spectators.delete(voterId);
+  const spectators = round.spectators;
   // ゲームのプレイヤーからも外す（#403 G-8）。最後のプレイヤーが外れたら見積もりへ戻す
   if (round.game !== null && game === null) return { ...round, spectators, ...backToEstimate };
   return { ...round, votes, spectators, game };
