# 変異 1222: dock-last-primary-not-full-width
#
# 検出を期待するテスト:
#   - packages/ui/tests/dock-and-narrow-header.test.mjs
#   - e2e/specs/header-and-dock.spec.ts（実際の見え方。変異検査の外）
#
# #554。奇数の最後の主が半分の幅になり、押しやすい主の操作が小さくなる（3 つなら 3 段にもなる）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1222-*.patch
# 復元: git apply -R scripts/mutations/m1222-*.patch
diff --git a/packages/ui/src/components/actions.css b/packages/ui/src/components/actions.css
--- a/packages/ui/src/components/actions.css
+++ b/packages/ui/src/components/actions.css
@@ -71,7 +71,7 @@
 
   /* 数え方の擬似クラスは :where() で包み、詳細度を (0,1,0) に抑える（部品層の約束は (0,2,0) まで。画面の `.roulette-controls .ui-button` などの上書きが勝つ） */
   .ui-actions--dock > :where(:nth-child(odd of :not([hidden], .ui-visually-hidden, select, .ui-actions-start)):nth-last-child(1 of :not([hidden], .ui-visually-hidden, select, .ui-actions-start))) {
-    grid-column: 1 / -1;
+    grid-column: auto;
   }
 
   /* 2 列の 1 つは (320 − 2×16 − 12) ÷ 2 = 138px。ボタンの左右の余白（`--lg` は 1.8rem ＝ 28.8px）を詰めないと「次のアイテムへ」が 2 行に折れる */
