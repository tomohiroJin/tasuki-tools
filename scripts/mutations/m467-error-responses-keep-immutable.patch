# 変異 467: error-responses-keep-immutable
#
# 検出を期待するテスト:
#   - apps/landing/tests/caddy-fragment-order.test.ts
#
# #434。エラーの応答を no-cache に上書きする `handle_errors` を外す。404 や将来のエラーページにも 1 年の immutable が付き、配布の途中に覚えた欠落を利用者のブラウザが 1 年持ち続ける。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m467-*.patch
diff --git a/deploy/caddy/tasuki.conf b/deploy/caddy/tasuki.conf
--- a/deploy/caddy/tasuki.conf
+++ b/deploy/caddy/tasuki.conf
@@ -93,9 +93,6 @@
 	header @hashed Cache-Control "public, max-age=31536000, immutable"
 	header @unhashed Cache-Control "no-cache"
 	header /site.webmanifest Content-Type "application/manifest+json"
-	handle_errors {
-		header Cache-Control "no-cache"
-	}
 
 	import /etc/caddy/tasuki/apps/*.conf
 }
