     const wantsAi = req.mode === "ai" && state.aiUnlocked && provider !== undefined && aiLimiter !== undefined;

+    this.cancel(roomCode);
     // ⚠ クールダウンの判定は中断（cancel）より先に行う（spec §5.3・E22）。
     if (wantsAi && aiLimiter.isCoolingDown(roomCode)) return "cooldown";
