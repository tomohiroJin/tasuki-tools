# 変異 79: cooldown-check-after-cancel
#
# 検出を期待するテスト:
#   - apps/tasuki-sync/test/topic-generation.test.ts
#     『作り直しがクールダウン中なら "cooldown" を返し、進行中の生成とお題を残す』（#91・E22）
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m79-*.patch
# 復元: git apply -R scripts/mutations/m79-*.patch
