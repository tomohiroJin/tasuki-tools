# 変異 253: participant.remove が資格を見ずに次の担当を選ぶ
#
# 検出を期待するテスト:
#   - apps/tasuki-sync/test/manual-skip-eligible.test.ts
#
# 適用: リポジトリルートから git apply scripts/mutations/m253-*.patch
# 復元: git apply -R scripts/mutations/m253-*.patch
#
# #376（PR #392 の 2 巡目）。運転中の人がルームを抜けると、一時離脱・不在の人に運転が回る（本番の経路）。
diff --git a/apps/tasuki-sync/src/application/command-handlers/participant-remove.ts b/apps/tasuki-sync/src/application/command-handlers/participant-remove.ts
index 97b6aab..e839ecb 100644
--- a/apps/tasuki-sync/src/application/command-handlers/participant-remove.ts
+++ b/apps/tasuki-sync/src/application/command-handlers/participant-remove.ts
@@ -207,7 +207,7 @@ export async function handleParticipantRemove(
     // 運転中の人が抜けるなら、次の担当は交代と同じ資格の規則で選ぶ（#376）。
     // 資格は抜けた後の名簿と、繰り上げを済ませた輪で測る（添字は `working` の輪のもの）。
     const ineligible = computeIneligibleIndices(membershipAfterRemoval, { ...timer, session: working.session, clock: working.clock });
-    const nextDriverIndex = nextDriverAfterRemoval(working.session, idx, ineligible);
+    const nextDriverIndex = nextDriverAfterRemoval(working.session, idx, undefined);
     const agg = evolve(working, { type: "MemberRemoved", index: idx, nextDriverIndex, now }, now);
     next = { ...next, timer: { ...next.timer, session: agg.session, clock: agg.clock } };
   }
