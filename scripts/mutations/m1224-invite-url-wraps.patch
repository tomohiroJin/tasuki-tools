# 変異 1224: invite-url-wraps
#
# 検出を期待するテスト:
#   - packages/ui/tests/dock-and-narrow-header.test.mjs
#   - e2e/specs/header-and-dock.spec.ts（実際の見え方。変異検査の外）
#
# #554。招待の URL が 2 行に折れ、隣のボタンと縦が揃わず、見出しが高くなる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1224-*.patch
# 復元: git apply -R scripts/mutations/m1224-*.patch
diff --git a/packages/ui/src/components/invite.css b/packages/ui/src/components/invite.css
--- a/packages/ui/src/components/invite.css
+++ b/packages/ui/src/components/invite.css
@@ -28,7 +28,7 @@
   /* `overflow: hidden` の flex 項目は min-width の自動の下限が 0 になるので、`min-width: 0`・`max-inline-size: 100%` は要らない（外して 320・390・639px の実物と、300px の折り返す flex の一時の箱で幅が変わらないことを確かめた・#554） */
   overflow: hidden;
   text-overflow: ellipsis;
-  white-space: nowrap;
+  white-space: normal;
   /* 1 回押すと URL 全体が選ばれる。クリップボードが使えない端末（非セキュアオリジン）で、手で選んでコピーする唯一の道（#76 F-1）。
      timer の旧 InvitePanel が持っていた性質を、5 つのアプリの共通の部品へ移した（#447 段 2） */
   user-select: all;
