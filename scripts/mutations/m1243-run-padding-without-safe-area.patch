# 変異 1243: run-padding-without-safe-area
#
# 検出を期待するテスト:
#   - apps/agenda-web/tests/run-controls-opaque.test.ts
#   - e2e/specs/header-and-dock.spec.ts（実際の見え方。変異検査の外）
#
# #554 のレビュー。iPhone のホームバーの高さが足りず、最下部で最後の行や「最初から」が不透明な帯に隠れる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1243-*.patch
# 復元: git apply -R scripts/mutations/m1243-*.patch
diff --git a/apps/agenda-web/src/run.css b/apps/agenda-web/src/run.css
--- a/apps/agenda-web/src/run.css
+++ b/apps/agenda-web/src/run.css
@@ -18,7 +18,7 @@
   /* 帯（`.run-controls`・固定）の高さ（上の線 1px ＋ 余白と 2 段で約 159px）に、iPhone のホームバーの高さ（`env(safe-area-inset-bottom)`・
      帯も同じだけ下の余白を足している）を足す。足りないと、最下部で最後の行や「最初から」が不透明な帯に隠れる（#554） */
   --run-controls-height: 10rem;
-  padding-bottom: calc(var(--run-controls-height) + env(safe-area-inset-bottom));
+  padding-bottom: var(--run-controls-height);
 }
 .run--finished {
   padding-bottom: 0;
