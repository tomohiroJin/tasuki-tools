# 変異 498: visibility-unlocked-after-play
#
# 検出を期待するテスト:
#   - packages/checkin-core/tests/checkin.test.ts
#     「1 人が出した後は CHECKIN_VISIBILITY_LOCKED（開いた後も）（E7）〈m498〉」
#
# #406 段 1。札が出た後も公開の仕方を変えられる。匿名のつもりで出した札が名前つきで開かれる（判断 5・E7）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m498-*.patch
# 復元: git apply -R scripts/mutations/m498-*.patch
diff --git a/packages/checkin-core/src/checkin.ts b/packages/checkin-core/src/checkin.ts
--- a/packages/checkin-core/src/checkin.ts
+++ b/packages/checkin-core/src/checkin.ts
@@ -88,7 +88,6 @@
   const r = s.round;
   if (r === null) return fail("CHECKIN_NO_ROUND");
   if (r.seq !== input.seq) return ok(s);
-  if (isVisibilityLocked(r)) return fail("CHECKIN_VISIBILITY_LOCKED");
   if (r.visibility === input.visibility) return ok(s);
   const seq = s.lastSeq + 1;
   return ok({ ...s, round: { ...r, seq, visibility: input.visibility }, lastSeq: seq });
