# 変異 90: topic-editor-draft-overwritten
#
# 検出を期待するテスト:
#   - apps/topic-web/tests/topic-room.test.tsx
#     describe「書く」の
#     「Given 下書きの途中 / When 別の人のお題が届く / Then 下書きは残る」
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m90-*.patch
# 復元: git apply -R scripts/mutations/m90-*.patch
#
# #91 PR 2。`TopicEditor` に `current`（届いたお題）が変わるたび下書きを上書きする
# `useEffect` を足す。#316 PR 1 の手直しで `TopicEditor` は届いたお題の prop を持たなくなった
# （写す中身は札の側が `fillRequest` に詰める）ので、このパッチは `current` の prop の追加
# （`TopicEditor.tsx`）と `TopicRoom.tsx` からの受け渡しも一緒に足す。壊し方（届いたお題で
# 下書きを上書きする）は変えていない。書いている途中に別の人がお題を変えると、打ちかけの下書きが
# 黙って消える —— コンポーネント冒頭のコメントが禁じている性質そのもの
# （「届いたお題で上書きしない」）。
diff --git a/apps/topic-web/src/components/TopicEditor.tsx b/apps/topic-web/src/components/TopicEditor.tsx
index 9b294bfc..7aa279f4 100644
--- a/apps/topic-web/src/components/TopicEditor.tsx
+++ b/apps/topic-web/src/components/TopicEditor.tsx
@@ -1,5 +1,5 @@
 import { useDeferredValue, useEffect, useId, useLayoutEffect, useRef, useState } from 'react';
-import { MAX_TOPIC_BODY, MAX_TOPIC_TITLE } from '@tasuki/topic-core';
+import { MAX_TOPIC_BODY, MAX_TOPIC_TITLE, type Topic } from '@tasuki/topic-core';
 import {
   BODY_HINT,
   BODY_LABEL,
@@ -24,6 +24,7 @@ export interface FillRequest {
 }
 
 interface Props {
+  readonly current?: Topic | null;
   /** 欄へ写す要求。null か、前と同じ object のあいだは何もしない */
   readonly fillRequest?: FillRequest | null;
   readonly enabled: boolean;
@@ -53,7 +54,7 @@ interface Props {
  * 切り替えのボタンを隠す。React の木は幅によらず同じで、ここが持つのは狭いときにどちらを出すか（`mode`）だけ。
  * 切り替えのボタンは `.ui-button--secondary --sm` で、選んだ側は `aria-pressed="true"` で示す（見た目は画面の CSS が太い枠と地で区別する）。
  */
-export function TopicEditor({ fillRequest = null, enabled, onDraftChange, onSubmit }: Props) {
+export function TopicEditor({ current, fillRequest = null, enabled, onDraftChange, onSubmit }: Props) {
   const [title, setTitle] = useState('');
   const [body, setBody] = useState('');
   const [mode, setMode] = useState<'write' | 'preview'>('write');
@@ -64,6 +65,12 @@ export function TopicEditor({ fillRequest = null, enabled, onDraftChange, onSubm
   const bodyId = useId();
   const previewId = useId();
   const canSubmit = canSubmitTopic(title, enabled);
+  useEffect(() => {
+    if (current) {
+      setTitle(current.title);
+      setBody(current.body);
+    }
+  }, [current]);
   const previewTitle = useDeferredValue(title);
   const previewBody = useDeferredValue(body);
   const previewBlank = previewTitle.trim() === '' && previewBody.trim() === '';
diff --git a/apps/topic-web/src/screens/TopicRoom.tsx b/apps/topic-web/src/screens/TopicRoom.tsx
index 071f611b..32506c67 100644
--- a/apps/topic-web/src/screens/TopicRoom.tsx
