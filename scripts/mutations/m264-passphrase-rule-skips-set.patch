# 変異 264: 合言葉を掛けるときに長さの上限を見ない
#
# 検出を期待するテスト:
#   - packages/room-core/tests/wire.test.ts
#
# 適用: リポジトリルートから git apply scripts/mutations/m264-*.patch
# 復元: git apply -R scripts/mutations/m264-*.patch
#
# #377。上限を超える合言葉を掛けられ、どの入口からもその合言葉では入れないルームができる。
# #638 で合言葉の設定が timer のコマンドから玄関（ハブ）のコマンドへ移ったので、壊す場所を
# timer の入口の規約（`passphrase-rule.ts`）から、ハブの `room.passphrase.set` のスキーマの上限へ移した（壊し方は同じ）。
diff --git a/packages/room-core/src/wire.ts b/packages/room-core/src/wire.ts
--- a/packages/room-core/src/wire.ts
+++ b/packages/room-core/src/wire.ts
@@ -138,7 +138,7 @@ export const HubCommandSchema: v.GenericSchema<HubCommand> = v.variant("command", [
   // 上限は参加の `room.join` と同じ 1 つの値（`./passphrase.ts`）。
   v.strictObject({
     command: v.literal("room.passphrase.set"),
-    passphrase: v.pipe(v.string(), v.maxLength(MAX_PASSPHRASE)),
+    passphrase: v.string(),
   }),
 ]);

