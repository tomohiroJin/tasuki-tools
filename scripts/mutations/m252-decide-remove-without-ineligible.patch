# 変異 252: decide の member.remove が資格を見ずに次の担当を選ぶ
#
# 検出を期待するテスト:
#   - packages/timer-core/test/decide.test.ts
#
# 適用: リポジトリルートから git apply scripts/mutations/m252-*.patch
# 復元: git apply -R scripts/mutations/m252-*.patch
#
# #376（PR #392 の 2 巡目）。運転中の人が外れると、一時離脱・不在の人に運転が回る（本番の経路）。
diff --git a/packages/timer-core/src/decide.ts b/packages/timer-core/src/decide.ts
index 656feac..a6de28a 100644
--- a/packages/timer-core/src/decide.ts
+++ b/packages/timer-core/src/decide.ts
@@ -363,7 +363,7 @@ function decideMemberRemove(
 
   // 運転中の人を外すなら、次の担当を交代と同じ資格の規則で選ぶ（#376）。
   // 位置で次の席にすると、一時離脱・不在の人に運転が回る。
-  const nextDriver = nextDriverAfterRemoval(agg.session, index, ineligible);
+  const nextDriver = nextDriverAfterRemoval(agg.session, index, undefined);
   // ランダム交代（#660）で運転中の人を外すなら、次の担当は袋から引いた人（予告した人）なので、袋も進める。
   // 適格な人が居なくて位置で次の席にしたとき（`drawn === index`）は、引いていないので袋を変えない。
   const drawn = index === agg.session.currentIndex ? nextDriverIndex(agg.session, index, ineligible) : index;
