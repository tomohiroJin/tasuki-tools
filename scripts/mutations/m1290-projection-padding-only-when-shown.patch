# 変異 1290: projection-padding-only-when-shown
#
# 検出を期待するテスト:
#   - apps/agenda-web/tests/run-controls-opaque.test.ts
#   - e2e/specs/header-and-dock.spec.ts（実際の見え方。変異検査の外。帯が出るたびに盤が動いて赤）
#
# #554 のレビュー。映す表示の下の余白が帯の出ている間だけになり、40rem 以上 64rem 未満で、帯が出るたびに盤が約 70px 上下に跳ねる（768・844×390・1000×700）（1280・1920・390）。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1290-*.patch
# 復元: git apply -R scripts/mutations/m1290-*.patch
diff --git a/apps/agenda-web/src/run.css b/apps/agenda-web/src/run.css
--- a/apps/agenda-web/src/run.css
+++ b/apps/agenda-web/src/run.css
@@ -590,7 +590,7 @@
   }
 }
 @media (width >= 40rem) and (width < 64rem) and (height >= 48rem) {
-  .projection-body {
+  .projection:has(> .projection-strip.is-shown, > .projection-strip:focus-within) > .projection-body {
     /* 通常の下の余白（--space-6）は足さず、帯の高さ（実測 69px < 4.4rem）に置き換える。足すと 768×1024 で帯を出さなくても縦のスクロールが出た（1065 > 1024） */
     padding-block-end: calc(var(--projection-strip-height) + env(safe-area-inset-bottom));
   }
