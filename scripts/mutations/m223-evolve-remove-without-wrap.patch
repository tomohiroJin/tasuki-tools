# #376（PR #392 のレビュー）。末尾の運転者を外すと次の担当が輪の長さちょうどになり、範囲外を指す。
diff --git a/packages/timer-core/src/aggregate.ts b/packages/timer-core/src/aggregate.ts
index 470e326..9f28341 100644
--- a/packages/timer-core/src/aggregate.ts
+++ b/packages/timer-core/src/aggregate.ts
@@ -310,7 +310,7 @@ export function nextDriverAfterRemoval(
   // 適格な人が居なければ nextEligibleIndex は外した席そのものを返す（外した席を飛ばすかどうかに関わらない）。
   // 長さ 1 なら外した席しか無いので、位置で次の席 (0 + 1) % 1 = 0 になる。
   const found = nextEligibleIndex(session, removedIndex, ineligible);
-  const chosen = found === removedIndex ? (removedIndex + 1) % len : found;
