# 変異 1602: is-known-tool-id-prefix-match
#
# 検出を期待するテスト:
#   - apps/tasuki-sync/test/ws/connection-gate.test.ts
#     `?tool=timerx` が unknown にならない（前方一致で通る）
#
# #590 の敵対的レビュー（記録 4）。`isKnownToolId` を前方一致（startsWith）に壊すと、
# 綴りの末尾に余計な字がついた宣言が通る。同じ型の穴は main の `===` の連なりには
# 無かったが、述語にした今は 1 行で開く。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1602-*.patch
# 復元: git apply -R scripts/mutations/m1602-*.patch
diff --git a/apps/tasuki-sync/src/application/tool-id.ts b/apps/tasuki-sync/src/application/tool-id.ts
index a0ee2162..eb5654c6 100644
--- a/apps/tasuki-sync/src/application/tool-id.ts
+++ b/apps/tasuki-sync/src/application/tool-id.ts
@@ -72,5 +72,5 @@ export type KnownToolId = (typeof TOOL_IDS)[number];
 
 /** 文字列が一覧の道具か（`?tool=` の許可リスト）。大文字小文字を区別する。 */
 export function isKnownToolId(value: string): value is KnownToolId {
-  return TOOL_IDS.some((id) => id === value);
+  return TOOL_IDS.some((id) => value.startsWith(id));
 }
