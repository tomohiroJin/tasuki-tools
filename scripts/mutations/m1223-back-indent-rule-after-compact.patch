# 変異 1223: back-indent-rule-after-compact
#
# 検出を期待するテスト:
#   - packages/ui/tests/dock-and-narrow-header.test.mjs（打ち消しが詰めた見た目の `margin-inline-start: auto` より前にあることを読む）
#
# #554。戻るの字下げを打ち消す規則を、詰めた見た目の戻る（`margin-inline-start: auto`）より後ろへ移す。規則の本体は残るので通常の見出しの揃いは保たれ（E2E は緑のまま）、
# 同じ詳細度で後ろに書かれた打ち消しが auto に勝ち、timer のセッション（詰めた見た目）の戻るが右端に寄らず左へ詰まる。順序の欠陥の型で、宣言を消す 1247 とは別。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1223-*.patch
# 復元: git apply -R scripts/mutations/m1223-*.patch
diff --git a/packages/ui/src/components/room-header.css b/packages/ui/src/components/room-header.css
--- a/packages/ui/src/components/room-header.css
+++ b/packages/ui/src/components/room-header.css
@@ -116,10 +116,6 @@
 /* 戻るは下線の字（`.ui-button--quiet`）の横の余白（`padding-inline` ＋ 枠 1px）ぶん、字が左へ 9px 字下がる。行の先頭に落ちたとき（40rem 未満の折り返しと、
    お題と記録があって題の行が埋まる 640〜668px 前後。#554・#479 の #13）に字の左端が題と揃うよう、幅によらず打ち消す。行の右端に置かれるときは、右寄せなので見た目が変わらない。
    詰めた見た目の `margin-inline-start: auto`（下）に勝たないよう、それより前に書く。 */
-.ui-room-header .ui-page-header-back {
-  margin-inline-start: calc(-1 * (var(--space-2) + 1px));
-}
-
 /* 詰めた見た目: 題・戻るリンク・「仲間を招く」を 1 つの行に並べ（40rem 未満は題を目に出さないので 1 行・下の @media）、招待の欄は開いたとき次の行に全幅で出す。
    `.ui-page-header` は `display: contents` で外し、題と戻るリンクを直接の子にする。通常の見た目の規則より強い連鎖で書く。幅によらず開くまでたたむ（@media の外）。 */
 .ui-room-header.ui-room-header--compact {
@@ -147,6 +143,10 @@
   margin-inline-start: auto;
 }
 
+.ui-room-header .ui-page-header-back {
+  margin-inline-start: calc(-1 * (var(--space-2) + 1px));
+}
+
 .ui-room-header--compact .ui-room-header-share {
   flex-basis: 100%;
 }
