# 変異 492: compact-narrow-title-shown
#
# 検出を期待するテスト:
#   - packages/ui/tests/room-header-wide-toggle.test.mjs（40rem 未満の詰めた見た目の道具名の規則を読む）
#   - e2e/specs/layout.spec.ts（390×844 の timer のセッション。実際の見え方。変異検査の外・手元では赤を見ていない）
#
# #447 段 2。40rem 未満の詰めた見た目で道具名を隠す規則を消す。見出しが 2 行（約 90px）になり、390×844 の timer のセッションで計器が下端の帯に潜る。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m492-*.patch
# 復元: git apply -R scripts/mutations/m492-*.patch
--- a/packages/ui/src/components/room-header.css
+++ b/packages/ui/src/components/room-header.css
@@ -171,21 +171,6 @@
 @media (width < 40rem) {
   .ui-room-header-share:not([data-open='true']) {
     display: none;
-  }
-
-  /* 詰めた見た目の狭い幅では、道具名を目に出さず読み上げにだけ残し、戻るリンクと「仲間を招く」を 1 行に収める。
-     道具名を出したままだと 2 行（約 90px）になり、390×844 の timer のセッションで計器が下端の帯に潜った（#447 段 2）。
-     宣言は部品の `.ui-visually-hidden` と同じ。空になった題の箱は伸びて、戻るリンクと「仲間を招く」を右へ寄せる。 */
-  .ui-room-header--compact .ui-room-header-title > h1 {
-    position: absolute;
-    width: 1px;
-    height: 1px;
-    padding: 0;
-    margin: -1px;
-    overflow: hidden;
-    clip-path: inset(50%);
-    white-space: nowrap;
-    border-width: 0;
   }
 
   /* 通常の見た目（`:not(.ui-room-header--compact)`）の 40rem 未満は、見出しの行・道具のボタン・戻る・「仲間を招く」を 1 つの折り返す行に並べ直す（#554・#479 の #11・#13）。
