# 変異 174: 回転の終わりを timer で保証しない（rAF が止まると止まらない）
#
# 検出を期待するテスト:
#   - apps/roulette-web/tests/wheel.test.tsx
#     describe「回転」の「Given rAF を 1 度も呼ばない環境 / When durationMs が過ぎる / Then timer で止まり、当たりの席と札の表が出る」
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m174-*.patch
# 復元: git apply -R scripts/mutations/m174-*.patch
#
# #94 spec §6.4。裏のタブやヘッドレスのブラウザでは rAF が止まる・間引かれる（2026-10-12 のヘッドレスの
# 撮影で、4 秒の回転が 14 秒後まで止まって見えなかった）。終わりは rAF に頼らず、残り時間の timer が保証する。
# PR #383 のレビューで「止まったか」の時計を画面の `useNowMs` の 1 つに寄せたので、壊す timer もそこへ移した。
diff --git a/apps/roulette-web/src/screens/RouletteRoom.tsx b/apps/roulette-web/src/screens/RouletteRoom.tsx
index c6ba87e..e836964 100644
--- a/apps/roulette-web/src/screens/RouletteRoom.tsx
+++ b/apps/roulette-web/src/screens/RouletteRoom.tsx
@@ -54,7 +54,7 @@ function useNowMs(receivedAt: number, wakeAts: readonly number[]): number {
     // まだ来ていない時刻すべてに timer を置く（#401: 1 人ずつ止まる）。1 つずつ待ち直す形にすると、
     // 裏のタブで timer が遅れて一度に起きたとき、次の時刻を「もう過ぎた」と見て待たずに止まったままになる
     const now = performance.now();
-    const timers = wakeAts.filter((at) => at > now).map((at) => setTimeout(() => setTick(performance.now()), at - now + 30));
+    const timers = wakeAts.filter((at) => at > now).map((at) => setTimeout(() => undefined, at - now + 30));
     return () => timers.forEach(clearTimeout);
     // eslint-disable-next-line react-hooks/exhaustive-deps -- 時刻の列は key（中身）で比べる（描くたびに新しい配列になる）
   }, [key]);
