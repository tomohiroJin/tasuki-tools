# 変異 2497: track-autostop-closes-at-fire-time
#
# 検出を期待するテスト:
#   - apps/tasuki-sync/test/track-auto-stop.test.ts
#
# #476 全員切断の停止が、切断の時刻でなく猶予の後の時刻で閉じる。FR-24。猶予のぶんが作業の時間に足される。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m2497-*.patch
# 復元: git apply -R scripts/mutations/m2497-*.patch
diff --git a/apps/tasuki-sync/src/application/track-auto-stop.ts b/apps/tasuki-sync/src/application/track-auto-stop.ts
--- a/apps/tasuki-sync/src/application/track-auto-stop.ts
+++ b/apps/tasuki-sync/src/application/track-auto-stop.ts
@@ -68,7 +68,7 @@
     if (!shouldStop(roomCode)) return;
     const state = deps.tracks.get(roomCode);
     if (state === undefined) return;
-    const next = autoStop(state, { at: since });
+    const next = autoStop(state, { at: deps.clock.now() });
     if (next === state) return;
