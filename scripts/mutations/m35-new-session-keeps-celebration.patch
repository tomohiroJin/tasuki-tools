# 変異 35: new-session-keeps-celebration
#
# 検出を期待するテスト:
#   - apps/timer-web/test/sync/use-timer-sync.test.tsx
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m35-*.patch
#       (diff のパスはリポジトリルート起点。mutation-check.mjs もリポジトリルートで実行する)
# 復元: git checkout -- <対象ファイル>（同じくリポジトリルートから）
#
# #290 で newSession の実装が「ルームが生きているなら遷移しない」形に変わり、
# if 文が単文から早期 return を持つブロックへ変わった（パッチの文脈行がずれて
# 当たらなくなっていたため、#290 で作り直した。変異そのもの ——
# 「ルームが生きているときの setPhase("setup") を送らない」——は変えていない）。
#
# #369 で use-timer-sync.ts から画面の操作（`apps/timer-web/src/sync/timer-actions.ts`）へ移った先を壊す（ID と意味は変えていない）。
diff --git a/apps/timer-web/src/sync/timer-actions.ts b/apps/timer-web/src/sync/timer-actions.ts
index a4e844d..64c8e6e 100644
--- a/apps/timer-web/src/sync/timer-actions.ts
+++ b/apps/timer-web/src/sync/timer-actions.ts
@@ -110,10 +110,6 @@ export function createTimerActions({
     // かつてここに `redirectTo("/")` があったのは、#249 以前の `newSession` が
     // 「まっさらな新しいルームを作る」操作で、旧 `Setup`（＝作成画面）へ戻していた
     // 名残である。押した本人だけがルームから出されていた。
-    if (room && !sessionLost) {
-      commands.setPhase("setup");
-      return;
-    }
     // ルームを失っているときは戻る先が無いので玄関へ（`SessionLost` と同じ）。
     redirectTo("/");
   };
