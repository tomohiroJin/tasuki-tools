diff --git a/packages/roulette-core/src/roulette.ts b/packages/roulette-core/src/roulette.ts
index 90f32874..86ecf2eb 100644
--- a/packages/roulette-core/src/roulette.ts
+++ b/packages/roulette-core/src/roulette.ts
@@ -259,7 +259,7 @@ export function addGuest(
   members: readonly Member[],
   conflicts: NameConflict,
 ): Result<RouletteState, RouletteError<"TOO_MANY_GUESTS" | "GUEST_NAME_TAKEN">> {
-  if (state.guests.length >= MAX_GUESTS) return err({ code: "TOO_MANY_GUESTS" });
+
   if (conflicts(existingOf(members, state.guests), name)) return err({ code: "GUEST_NAME_TAKEN" });
