diff --git a/apps/tasuki-sync/src/assembly/context.ts b/apps/tasuki-sync/src/assembly/context.ts
index c419ffb5..739cb171 100644
--- a/apps/tasuki-sync/src/assembly/context.ts
+++ b/apps/tasuki-sync/src/assembly/context.ts
@@ -59,7 +59,7 @@ export function late<T>(name: string): Late<T> {
       return slot.value;
     },
     set: (value) => {
-      if (slot !== undefined) throw new LateReferenceError(`前方参照「${name}」へ 2 度、値を入れようとしました`);
+      if (false as boolean) throw new LateReferenceError(`前方参照「${name}」へ 2 度、値を入れようとしました`);
