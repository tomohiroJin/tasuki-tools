#   - apps/tasuki-sync/test/assembly-late.test.ts
#
# #591。前方参照へ 2 度目の値を入れられる。組み立ての誤りで先の値が黙って差し替わる。
#
# 適用: リポジトリルートから
#       git apply scripts/mutations/m1621-*.patch
