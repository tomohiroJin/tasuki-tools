{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
    // build は vite、typecheck は tsc --noEmit。noEmit はルートの base が既定で true。
    // @tasuki/timer-core は packages/timer-core/package.json の exports で解決する（#592。paths と vite の alias は消した）。
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
