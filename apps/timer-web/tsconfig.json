{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // build は vite、typecheck は tsc --noEmit。noEmit はルートの base が既定で true。
    "paths": {
      "@tasuki/timer-core": ["../../packages/timer-core/src/index.ts"],
      "@tasuki/timer-core/*": ["../../packages/timer-core/src/*.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
