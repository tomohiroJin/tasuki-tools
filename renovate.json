{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "labels": ["dependencies"],
  "lockFileMaintenance": { "enabled": true },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "7 days",
    "labels": ["dependencies", "security"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "toolchain.json の Bun（#487・docs/adr/0031）。ci.yml の bun-version から移したので、github-actions の manager はもう拾わない。depName は下の Bun の規則（承認制）に当てるため bun にする",
      "managerFilePatterns": ["/^toolchain\\.json$/"],
      "matchStrings": ["\"bun\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "bun",
      "packageNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v(?<version>.+)$"
    }
  ],
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "groupName": "非破壊的な更新", "groupSlug": "non-breaking" },
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true },
    { "matchUpdateTypes": ["lockFileMaintenance"], "minimumReleaseAge": null },
    { "matchDepNames": ["bun", "@types/bun"], "groupName": "Bun", "groupSlug": "bun", "dependencyDashboardApproval": true }
  ]
}
