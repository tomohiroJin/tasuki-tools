# 依存・ビルド成果物
node_modules/
# 仮想ストアの逃がし先。実体のディレクトリにも、別のファイルシステムへ向けた
# symlink にも当たるよう、末尾スラッシュを付けない（付けるとディレクトリ限定になる）。
.pnpm-virtual
dist/
build/
out/
.turbo/
*.tsbuildinfo

# テスト・カバレッジ
coverage/
.vitest/
e2e/test-results/

# ログ・一時ファイル
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# 環境・機密（コミット禁止）
.env
.env.*
!.env.example

# エディタ
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
.superpowers/

# poker 由来（planning-poker/.gitignore から統合）
