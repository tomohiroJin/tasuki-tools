# Tasuki の玄関（LP）のデプロイ定義（この値の定義場所はここだけ）
#
# **静的サイト。** sync サーバーを持たないので systemd ユニットもポートも要らない。
# Caddy が直接配信する。deploy.sh は STATIC_ONLY=1 を見て、バンドルと
# サービス再起動の段を飛ばす。
#
# 注意: S3（#18）では**暫定パス /home/ で配信**する。既存 URL（/ = timer）には
# 触れない。S4（#19）でルートへ移す。

APP_NAME=landing
STATIC_ONLY=1

WEB_ROOT=/var/www/tasuki-home

BUILD_FILTER=@tasuki/landing
WEB_DIST=apps/landing/dist

PUBLIC_PATH=/home/
