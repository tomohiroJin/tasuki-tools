# Tasuki Planning Poker — Caddy サイトブロックに import する断片
# 例: tasuki.niku9.click のサイトブロック内に `import /etc/caddy/Caddyfile.poker`
#
# 前提:
# - web の静的ビルド（apps/web/dist、base=/poker/）を /opt/tasuki/planning-poker/web に配置
# - sync サーバー（bun）が localhost:3311 で稼働（poker-sync.service）

# WebSocket リバースプロキシ（/poker/ws → sync の /ws）
handle /poker/ws {
	rewrite * /ws
	reverse_proxy localhost:3311
}

# 静的配信（SPA フォールバック付き）
handle_path /poker/* {
	root * /opt/tasuki/planning-poker/web
	try_files {path} /index.html
	file_server
}

# /poker（末尾スラッシュなし）を /poker/ へ
redir /poker /poker/ permanent
