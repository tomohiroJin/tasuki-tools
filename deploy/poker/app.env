# Planning Poker のデプロイ定義（この値の定義場所はここだけ）
#
# 注意: poker は **本番未公開**。S4（#19）で LP 公開と同時に初回デプロイする。
# ここにある資材は S2 で規約を揃えるために用意したもので、まだ使われていない。

APP_NAME=poker
SERVICE=tasuki-poker-sync
PORT=3311

APP_DIR=/opt/tasuki-poker
WEB_ROOT=/var/www/tasuki-poker

BUILD_FILTER=@tasuki/poker-web
WEB_DIST=apps/poker-web/dist
SYNC_ENTRY=apps/poker-sync/src/server.ts
ENV_FILE=tasuki-poker-sync.env

PUBLIC_PATH=/poker/
