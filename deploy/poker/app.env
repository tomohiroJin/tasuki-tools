# Planning Poker のデプロイ定義（この値の定義場所はここだけ）
#
# **静的サイトになった（#95 S2）。** 同期サーバーは timer と 1 本に統合され
# （`apps/tasuki-sync`・サービス `tasuki-sync`・ポート 8787）、poker 専用の
# systemd ユニット・ポート・env ファイルは無くなった。ここに残るのは web の配信だけで、
# WebSocket は Caddy 断片（`caddy/20-poker.conf`）が 8787 へ中継する。
#
# ⚠ **STATIC_ONLY のときに SERVICE / PORT / APP_DIR / SYNC_ENTRY / ENV_FILE を
# 書いてはならない。** `deploy/lib/common.sh` がどちらが本当か決められないとして
# 起動を止める（fail-closed で正しい挙動）。
#
# 旧ユニット（`tasuki-poker-sync`）の停止手順は NOTES.md にある。

APP_NAME=poker
STATIC_ONLY=1

WEB_ROOT=/var/www/tasuki-poker

BUILD_FILTER=@tasuki/poker-web
WEB_DIST=apps/poker-web/dist

PUBLIC_PATH=/poker/
