# Tasuki Planning Poker 同期サーバー（Bun）
# 配置: /etc/systemd/system/poker-sync.service
# 既存サービス（tdd-mob-pro-timer）とは別ポート・別ユニットで同居する（憲法 追加制約）
[Unit]
Description=Tasuki Planning Poker sync server (Bun + WebSocket)
After=network.target

[Service]
Type=simple
# bun build --target=bun で単一ファイル化したサーバー（node_modules 不要）
ExecStart=/usr/local/bin/bun run /opt/tasuki/planning-poker/sync/server.js
Environment=PORT=3311
Restart=on-failure
RestartSec=3
# 運用ユーザーに合わせて変更する
User=www-data
Group=www-data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
