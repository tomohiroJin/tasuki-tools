# Tasuki sync（poker）本番環境変数のテンプレート
# setup.sh が @PORT@ を app.env の値に置換して $APP_DIR/tasuki-poker-sync.env を作る。
# **実体（tasuki-poker-sync.env）はコミットしない。** 600 で VPS 上にのみ置く。
NODE_ENV=production
PORT=@PORT@
HOST=127.0.0.1

# 公開ドメイン。実値に書き換えること（複数はカンマ区切り）。
# **本番では必須**。空のまま起動しようとするとサーバーは起動を拒否する（CSWSH 防止）。
ALLOWED_ORIGINS=https://<公開ドメイン>

# 以下は接続・フレーム層の防御（Issue #63）。省略時は括弧内の既定値が使われる。
# 通常は書き換え不要で、負荷や攻撃の状況に応じて絞るためのつまみ。
# MAX_CONNECTIONS=200          # 同時接続数の上限（超過は 1013 で拒否）
# MAX_ROOMS=50                 # 保持するルーム数の上限（超過は新規作成のみ拒否）
# MAX_MESSAGE_BYTES=65536      # 1 メッセージの最大バイト数（超過はエラー応答・接続は保つ）
#                              # 天井は 1MB。WebSocket のフレーム上限はこの値の 2 倍に
#                              # 設定され、そこを超えるフレームは応答できず切断になる
# HEARTBEAT_INTERVAL_MS=15000  # 死活監視の ping 送信間隔
# HEARTBEAT_MAX_MISSES=2       # 連続でこの回数 pong が無ければ切断
