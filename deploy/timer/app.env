# TDD Mob Pro Timer のデプロイ定義（この値の定義場所はここだけ）
#
# 注意: SERVICE は本番で稼働中の名前を**据え置いている**。
# 命名規約（tasuki-<tool>-sync）に揃えるなら改名になるが、稼働ユニットの
# 改名は「旧停止 → 新起動」の切り替えを伴い、失敗すればサービス断になる。
# 得られるのは命名の一貫性だけで機能上の利得が無いため、改名しない。

APP_NAME=timer
SERVICE=tasuki-sync
PORT=8787

APP_DIR=/opt/tasuki
WEB_ROOT=/var/www/tasuki

BUILD_FILTER=@tasuki/timer-web
WEB_DIST=apps/timer-web/dist
SYNC_ENTRY=apps/timer-sync/src/server.ts
ENV_FILE=tasuki-sync.env

# 公開パス。S4（#19）で /timer/ へ移設する予定。
PUBLIC_PATH=/
