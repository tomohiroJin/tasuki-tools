# Tasuki sync（統合サーバー）本番環境変数のテンプレート
# **#95 S2 で timer と poker の 2 本を 1 プロセスへ統合した。** poker 側の
# tasuki-poker-sync.env はもう作られない（旧テンプレート deploy/poker/env.example は削除）。
# setup.sh が @PORT@ を app.env の値に置換して $APP_DIR/tasuki-sync.env を作る。
# **実体（tasuki-sync.env）はコミットしない。** 600 で VPS 上にのみ置く。
NODE_ENV=production
PORT=@PORT@
HOST=127.0.0.1

# 公開ドメイン。実値に書き換えること（複数はカンマ区切り）。
ALLOWED_ORIGINS=https://<公開ドメイン>

# 同時接続数の上限（超過は 1013 で拒否）。**プロセス全体で 1 つ**である。
# 統合前は timer と poker がそれぞれ 200 を持ち、実効枠は合計 400 だった。
# 統合で接続レジストリが 1 つになったため、実効枠を保つ値として 400 に決め直した
# （#95 S2・設計正本 D22）。
#
# ⚠ **このテンプレートの変更は稼働中の本番へ自動では届かない。** setup.sh は
# $APP_DIR/$ENV_FILE が既にあれば上書きしない（既存を保持する）。統合の切り替え時は
# deploy/poker/NOTES.md の手順 1 で実 env を手で直すこと。飛ばすと timer と poker が
# 合計 200 枠を共有し、D22 が避けようとした実効枠の半減がそのまま起きる。
MAX_CONNECTIONS=400

# 保持するルーム数の上限（超過時は新規作成のみ拒否）。**プロセス全体で 1 つ**である ——
# #95 S4a で名簿が 1 つの保管になり、timer の入口も poker の入口も同じ件数を見る。
# 統合前は 2 プロセスがそれぞれ 50 を持ち、実効枠は 50 × 2 = 100 だった。1 本で
# 数えるようになった以上、実効枠を保つ値は 100 である（`MAX_CONNECTIONS` が S2 で
# 200 → 400 になったのとまったく同型の調整）。
#
# ⚠ **S4a で同時に占有される数は増える。** poker のルームが「最後の接続が切れたら
# 即時破棄」から下の ROOM_IDLE_TTL_MS 保持へ変わったためである。
# **TTL は縮めないこと** —— timer の復帰体験（席を外して戻る）まで巻き添えになる。
#
# ⚠ **このテンプレートの変更は稼働中の本番へ自動では届かない**（MAX_CONNECTIONS と同じ）。
# 切り替えの手順は deploy/timer/NOTES.md の「#95 S4a を配布するときに 1 度だけ行うこと」。
MAX_ROOMS=100

ROOM_IDLE_TTL_MS=1800000

# ── 任意: 接続・フレーム層の防御（省略時は括弧内の既定値）──────────────
# 通常は書き換え不要で、負荷や攻撃の状況に応じて絞るためのつまみ。
# MAX_MESSAGE_BYTES=65536      # 1 メッセージの最大バイト数（超過はエラー応答・接続は保つ）
#                              # 指定できるのは 1MB まで（超える値は 1MB に丸める）。
#                              # WebSocket のフレーム上限は MAX_MESSAGE_BYTES の 2 倍
#                              # （既定なら 128KB）。そこを超えるフレームはアプリに届かず、
#                              # エラー応答を返せないまま切断になる
# HEARTBEAT_INTERVAL_MS=15000  # 死活監視の ping 送信間隔
# HEARTBEAT_MAX_MISSES=2       # 連続でこの回数 pong が無ければ切断

# ── 任意: AI お題生成 ──────────────────────────────────────────────
# 未設定なら定型お題へ安全に縮退する。設定する場合のみ書く。
# AI_UNLOCK_KEY=<解錠の合言葉。openssl rand -hex 20 で生成する>
# 長さ・文字種・生成方法の規範は docs/adr/0011-threat-model-and-data-classification.md 決定5。
# CLAUDE_CODE_OAUTH_TOKEN=<トークン>
# AI_PROBLEM_MODEL=<モデル名>
# AI_GENERATION_TIMEOUT_MS=60000
# AI_DAILY_LIMIT=50
# ADMIN_TOKEN=<運用確認用トークン>
