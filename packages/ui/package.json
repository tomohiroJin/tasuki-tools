{
  "name": "@tasuki/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "//": "CSS と書体だけのパッケージ。build / typecheck は持たない（TS を足すまで不要）。lint（stylelint: 構文と、トークン層に要素セレクタを置かせない境界の検査）と test（node:test: トークンの契約と書体ファイルの実在の検査）は持つ。",
  "exports": {
    ".": "./src/index.css",
    "./tokens.css": "./src/tokens/index.css",
    "./elements.css": "./src/elements/index.css",
    "./base.css": "./src/elements/reset.css",
    "./controls.css": "./src/elements/controls.css",
    "./card.css": "./src/elements/card.css"
  },
  "scripts": {
    "lint": "stylelint \"src/**/*.css\"",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0"
  }
}
