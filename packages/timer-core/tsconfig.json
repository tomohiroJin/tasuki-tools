{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ルートの base は noEmit: true が既定。このパッケージは tsc で dist を出すので上書きする。
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
